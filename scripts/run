#!/usr/bin/env bash
set -euo pipefail

native=false
if [ "${1:-}" = "--native" ]; then
  native=true
  shift
fi

if [ $# -lt 1 ]; then
  echo "Usage: scripts/run [--native] <pipeline> [pipeline flags, e.g. --upload]" >&2
  exit 1
fi

cd "$(dirname "$0")/.."

if [ "$native" = true ]; then
  QLEVER_ENV=native exec npm run pipeline:start -- "$@"
fi

pipeline="$1"
shift
PIPELINE="$pipeline" PIPELINE_FLAGS="$*" exec docker compose up --build --exit-code-from pipeline
