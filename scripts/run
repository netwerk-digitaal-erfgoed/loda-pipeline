#!/usr/bin/env bash
set -euo pipefail

native=false
if [ "${1:-}" = "--native" ]; then
  native=true
  shift
fi

if [ $# -ne 1 ]; then
  echo "Usage: scripts/run [--native] <pipeline>" >&2
  exit 1
fi

cd "$(dirname "$0")/.."

if [ "$native" = true ]; then
  QLEVER_ENV=native exec npm start -- "$1"
fi

PIPELINE="$1" exec docker compose up --build --exit-code-from pipeline
