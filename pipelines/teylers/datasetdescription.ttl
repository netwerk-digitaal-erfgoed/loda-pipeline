@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://dc4eu.nl/id/datasets/teylers> a dcat:Dataset ;
	dcterms:title "Teylers Museum"@en ;
	dcterms:description "EDM version of dataset Teylers Museum - converted via LODA-pipeline for delivery to Euroepana."@en ;
	dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
	dcterms:creator <https://www.wikidata.org/wiki/Q474563> ;
	dcat:distribution <https://dc4eu.nl/id/datasets/teylers/dist-nt>, <https://dc4eu.nl/id/datasets/teylers/dist-xml> ;
	dcterms:created "2026-08-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
	dcterms:issued "2026-08-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
	dcterms:modified "2026-08-12T11:08:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
	dcterms:language "mul" ;
	dcterms:publisher <https://dc4eu.nl> ;
	dcat:keyword "LODA-pipeline","Europeana" ;
	# TODO ad dcat:contactPoint with value "dc4eu@beeldengeluid.nl" ;
	dcterms:source "https://datasetregister.netwerkdigitaalerfgoed.nl/dataset?uri=https://n2t.net/ark:/72166/dataset" .

<https://www.wikidata.org/wiki/Q474563> a foaf:Organization ;
	foaf:name "Teylers Museum"@nl .

<https://dc4eu.nl> a foaf:Organization ;
	foaf:name "DC4EU"@nl .

<https://dc4eu.nl/id/datasets/teylers/dist-nt> a dcat:Distribution ;
	dcterms:description "Gzipped distribution of 1884155 N-triples."@en ;
	dcat:byteSize "21372758"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ;
	dcterms:created "2026-08-12T11:08:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
	dcterms:issued "2026-08-12T11:08:50Z"^^<http://www.w3.org/2001/XMLSchema#date> ;
	dcterms:modified "2026-08-12T11:08:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
	dcat:accessURL <https://nde-europeana.ams3.digitaloceanspaces.com/teylers.nt.gz> ;
	dcat:downloadURL <https://nde-europeana.ams3.digitaloceanspaces.com/teylers.nt.gz> ;
	dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
	dcterms:format "application/n-triples+gzip" ;
	dcat:mediaType <https://www.iana.org/assignments/media-types/application/n-triples+gzip> ;
	dcterms:conformsTo <http://www.europeana.eu/schemas/edm/> .

<https://dc4eu.nl/id/datasets/teylers/dist-xml>  a dcat:Distribution ;
	dcterms:description "Zipped distribution of 64374 EDM XML files."@en ;
	dcat:byteSize "89006101"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ;
	dcterms:created "2026-08-12T11:08:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
	dcterms:issued "2026-08-12T11:08:50Z"^^<http://www.w3.org/2001/XMLSchema#date> ;
	dcterms:modified "2026-08-12T11:08:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
