	dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
	dcterms:format "application/zip" ;
	dcat:mediaType <http://www.iana.org/assignments/media-types/application/rdf+xml> ;
	dcat:compressFormat <https://www.iana.org/assignments/media-types/application/zip> ;
	dcterms:conformsTo <http://www.europeana.eu/schemas/edm/> ;
	edm:hasTransformation <#transformation> .

<#transformation> a edm:DataTransformationResource ;
	rdf:value "https://github.com/netwerk-digitaal-erfgoed/loda-pipeline/raw/refs/heads/main/pipelines/teylers/edm-generator-providedcho.rq","https://github.com/netwerk-digitaal-erfgoed/loda-pipeline/raw/refs/heads/main/pipelines/teylers/edm-generator-aggregation.rq","https://github.com/netwerk-digitaal-erfgoed/loda-pipeline/raw/refs/heads/main/pipelines/teylers/iterator.rq","https://github.com/netwerk-digitaal-erfgoed/loda-pipeline/raw/refs/heads/main/pipelines/teylers/iterator.rq" ;
	dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/#construct> ;
	edm:hasOutputFormat <http://www.europeana.eu/schemas/edm/> .
