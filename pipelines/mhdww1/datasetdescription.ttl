@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://dc4eu.nl/id/datasets/mhdww1> a dcat:Dataset ;
	dcterms:title "Museum Huis Doorn - Eerste Wereldoorlog"@en ;
	dcterms:description "EDM version of dataset Museum Huis Doorn - Eerste Wereldoorlog - converted via LODA-pipeline for delivery to Euroepana."@en ;
	dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
	dcterms:creator <https://www.huisdoorn.nl> ;
	dcat:distribution <https://dc4eu.nl/id/datasets/mhdww1/dist-nt>, <https://dc4eu.nl/id/datasets/mhdww1/dist-xml> ;
	dcterms:created "2026-08-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
	dcterms:issued "2026-08-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
	dcterms:modified "2026-08-12T12:14:07Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
	dcterms:language "nl" ;
	dcterms:publisher <https://dc4eu.nl> ;
	dcat:keyword "LODA-pipeline","Europeana" ;
	# TODO ad dcat:contactPoint with value "dc4eu@beeldengeluid.nl" ;
	dcterms:source "https://datasetregister.netwerkdigitaalerfgoed.nl/dataset?uri=https://atlantislite.deventit.nl/AtlantisPubliek/data/dataset/MHD%2B-%2BEerste%2BWereldoorlog" .

<https://www.huisdoorn.nl> a foaf:Organization ;
	foaf:name "Museum Huis Doorn"@nl .

<https://dc4eu.nl> a foaf:Organization ;
	foaf:name "DC4EU"@nl .

<https://dc4eu.nl/id/datasets/mhdww1/dist-nt> a dcat:Distribution ;
	dcterms:description "Gzipped distribution of 2331 N-triples."@en ;
	dcat:byteSize "30247"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ;
	dcterms:created "2026-08-12T12:14:07Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
	dcterms:issued "2026-08-12T12:14:07Z"^^<http://www.w3.org/2001/XMLSchema#date> ;
	dcterms:modified "2026-08-12T12:14:07Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
	dcat:accessURL <https://nde-europeana.ams3.digitaloceanspaces.com/mhdww1.nt.gz> ;
	dcat:downloadURL <https://nde-europeana.ams3.digitaloceanspaces.com/mhdww1.nt.gz> ;
