	dcat:mediaType <https://www.iana.org/assignments/media-types/application/n-triples+gzip> ;
	dcterms:conformsTo <http://www.europeana.eu/schemas/edm/> .

<https://dc4eu.nl/id/datasets/mhdww1/dist-xml>  a dcat:Distribution ;
	dcterms:description "Zipped distribution of 100 EDM XML files."@en ;
	dcat:byteSize "138997"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ;
	dcterms:created "2026-08-12T12:14:07Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
