PREFIX sdo: <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX edm:     <http://www.europeana.eu/schemas/edm/>
PREFIX ore:     <http://www.openarchives.org/ore/terms/>
PREFIX svcs:    <http://rdfs.org/sioc/services#>

CONSTRUCT {

    # The mandatory properties for ore:Aggregation are:
    # - edm:dataProvider
    # - edm:isShownAt OR edm:isShownBy
    #   (at least one should be present, recommened to have both and they can be used alongside each other)
    # - edm:provider
    # - edm:rights
    # - edm:aggregatedCHO,
    # - edm:ugc (if applicable)
    #
    # The recommended properties are:
    # - edm:object
    # - edm:intermediateProvider

    ?aggregation_URI a ore:Aggregation ;
        edm:aggregatedCHO ?providedCHO_URI ; # The identifier of the source object e.g. the Mona Lisa itself, ref [1..1]
#       edm:dataProvider ?dataProvider ;     # The name or identifier of the data provider of the object, literal, ref [1..1]
        edm:hasView ?additionalContentUrl, ?thumbnailUrl ; # The URL of a web resource which is a digital representation of the CHO, ref [0..m]
                                             # This may be the source object itself in the case of a born digital cultural heritage object.
                                             # edm:hasView should only be used where there are several views of the CHO and one (or both)
                                             # of the mandatory edm:isShownAt or edm:isShownBy properties have already been used, ref [0..1]
        edm:isShownAt $this ;                # The URL of a web view of the object in full information context, ref [0..1]
        edm:isShownBy ?primaryContentUrl ;   # The URL of a web view of the object. An edm:isShownBy must be provided, ref [0..1]
        edm:object ?objectUrl ;              # The URL of a representation of the CHO which will be used for generating previews for use in the Europeana portal, ref [0..1]

        # fixed value for this pipelines
        edm:provider "DC4EU" ;               # The name or identifier of the provider of the object, literal, ref [1..1]
        edm:intermediateProvider "NDE" ;     # The name or identifier of the intermediate organization that selects, collates, or curates data from a Data Provider that is then aggregated by a Provider from which Europeana harvests, literal, ref [0..n]

        edm:rights ?rights ;                 # This is a mandatory property and the value given here should be the rights statement that applies to the digital representation, ref [1..1]
#       edm:ugcProperty                      # This is a mandatory property for objects that are user generated or user created that have been collected by crowdsourcing or project activity, literal [0..1]


        .                                    # termination of the ore:Aggregation object (do not remove!)

    # TODO: check with https://europeana.atlassian.net/wiki/x/eYB9gg for the correct implementation

    # the following classes are used to model the images and their access through the IIIF Image API
    ?webresource_URI a edm:WebResource ;
        edm:rights ?additionalRights ;  # Overrides the edm:rights of the ore:Aggregation for this view.
        svcs:has_service ?service_URI   # The identifier of the svcs:Service required to consume the edm:WebResource.

        .                              # termination of the edm:WebResource object (do not remove!)

    ?primaryContentUrl dcterms:isReferencedBy ?IIIF_Presentation_API_URI . # A related resource that references, cites, or otherwise points to the described resource.
                                                            # In IIIF, dcterms:isReferencedBy can be used to connect an edm:WebResource to a IIIF manifest URI.

    ?service_URI a svcs:Service ;      # The identifier is the base URI of the IIIF image.
        dcterms:conformsTo <http://iiif.io/api/image> ; # An established standard to which the web resource or service conforms.
                                        # If the Service describes a IIIF resource, dcterms:conformsTo must be used
                                        # to describe the IIIF protocol the resource is conforming to.

        .                               # # termination of the svcs:Service object (do not remove!)

}
WHERE {
    # edm:isShownBy, edm:object and edm:rights can only occur once, so pick one media object per record.
    # This must stay the first sub-select: it is where the pipeline injects $this.
    {
        SELECT $this (MIN(STR(?_url)) AS ?_primaryUrl) (MIN(STR(?_anyLicense)) AS ?_firstLicense) (MIN(STR(?_anyThumbnail)) AS ?_firstThumbnail) WHERE {
            $this a sdo:CreativeWork .
            OPTIONAL { $this sdo:associatedMedia/sdo:contentUrl ?_url }
            OPTIONAL { $this sdo:associatedMedia/sdo:license ?_anyLicense }
            OPTIONAL { $this sdo:associatedMedia/sdo:thumbnailUrl ?_anyThumbnail }
        }
        GROUP BY $this
    }

    # mint a URI for the edm:ProvidedCHO and ore:Aggregation objects
    BIND(URI(CONCAT(STR($this),"#cho")) as ?providedCHO_URI)
    BIND(URI(CONCAT(STR($this),"#agg")) as ?aggregation_URI)

    BIND(IRI(?_primaryUrl) as ?primaryContentUrl)

    # use the license of the primary media object, or of the other media if none has a contentUrl, or else of the dataset
    OPTIONAL {
        $this sdo:associatedMedia ?_primaryMedia .
        ?_primaryMedia sdo:contentUrl ?primaryContentUrl ;
                       sdo:license ?_primaryLicense .
    }
    # TODO: revert to use ?datasetLicense
    # BIND(COALESCE(STR(?_primaryLicense), IF(BOUND(?_primaryUrl), 1/0, ?_firstLicense), STR(?datasetLicense)) as ?_rightsUrl)
    BIND(COALESCE(STR(?_primaryLicense), IF(BOUND(?_primaryUrl), 1/0, ?_firstLicense)) as ?_rightsUrl)
    # the licence statements in the EDM shape only use http
    BIND(IRI(REPLACE(?_rightsUrl, "^https://(creativecommons\\.org|rightsstatements\\.org)/", "http://$1/")) as ?rights)

    # edm:object must be an image: use the thumbnail if the primary media object is not one
    OPTIONAL {
        $this sdo:associatedMedia ?_primaryImage .
        ?_primaryImage a sdo:ImageObject ;
                       sdo:contentUrl ?primaryContentUrl .
    }
    BIND(IF(BOUND(?_primaryImage), ?primaryContentUrl, IRI(?_firstThumbnail)) as ?objectUrl)

    # see if an IIIF-Presentation API is defined
    OPTIONAL {
        $this sdo:associatedMedia ?IIIF_Presentation_API_URI .
        ?IIIF_Presentation_API_URI sdo:encodingFormat ?_encodingFormat .
        FILTER(REGEX(?_encodingFormat, "^application/ld\\+json;profile=['\"]http://iiif\\.io/api/presentation/"))
    }

    # the first branch makes sure the constant triples are emitted for every record
    { $this a sdo:CreativeWork }
    UNION {
        $this sdo:associatedMedia ?_media .
        ?_media sdo:contentUrl ?_contentUrl .
        OPTIONAL { ?_media sdo:license ?_mediaLicense }
    }
    UNION {
        $this sdo:associatedMedia/sdo:thumbnailUrl ?_thumbnailUrl .
        BIND(IRI(STR(?_thumbnailUrl)) as ?thumbnailUrl)
    }

    BIND(IRI(STR(?_contentUrl)) as ?webresource_URI)

    # the other media objects are additional views with their own license
    BIND(IF(STR(?_contentUrl) != ?_primaryUrl, ?webresource_URI, 1/0) as ?additionalContentUrl)
    BIND(IF(STR(?_contentUrl) != ?_primaryUrl,
            IRI(REPLACE(STR(?_mediaLicense), "^https://(creativecommons\\.org|rightsstatements\\.org)/", "http://$1/")),
            1/0) as ?additionalRights)

    # a IIIF image URL ends in /{region}/{size}/{rotation}/{quality}.{format}: the part before that is its base URI
    BIND(IF(REGEX(STR(?_contentUrl), "^.+/(full|square|[0-9.,]+|pct:[0-9.,]+)/(max|full|\\^?!?[0-9,]+|\\^?pct:[0-9.]+)/!?[0-9.]+/(default|color|gray|bitonal)\\.[a-z0-9]+$"),
            IRI(REPLACE(STR(?_contentUrl), "/(full|square|[0-9.,]+|pct:[0-9.,]+)/(max|full|\\^?!?[0-9,]+|\\^?pct:[0-9.]+)/!?[0-9.]+/(default|color|gray|bitonal)\\.[a-z0-9]+$", "")),
            1/0) as ?service_URI)
}
