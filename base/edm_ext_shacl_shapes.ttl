@prefix wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#> .


#####################################
### License statement definitions ###
#####################################

:licenseStatementCondition
    sh:or (
      [ sh:pattern "^http://creativecommons\\.org/licenses/(by|by-sa|by-nd|by-nc|by-nc-sa|by-nd-nc)/1\\.0/((fi|il|nl)/)?$" ]
      [ sh:pattern "^http://creativecommons\\.org/licenses/(by|by-sa|by-nd|by-nc|by-nc-sa|by-nd-nc)/2\\.0/((au|at|be|br|ca|cl|hr|uk|fr|de|it|jp|nl|pl|kr|es|tw)/)?$" ]
      [ sh:pattern "^http://creativecommons\\.org/licenses/(by|by-sa|by-nd|by-nc|by-nc-sa|by-nd-nc)/2\\.1/(au|es|jp)/$" ]
      [ sh:pattern "^http://creativecommons\\.org/licenses/(by|by-sa|by-nd|by-nc|by-nc-sa|by-nd-nc)/2\\.5/((ar|au|br|bg|ca|cn|co|hr|dk|hu|in|il|it|mk|my|mt|mx|nl|pe|pl|pt|scotland|si|za|es|se|ch|tw)/)?$" ]
      [ sh:pattern "^http://creativecommons\\.org/licenses/(by|by-sa|by-nd|by-nc|by-nc-sa|by-nd-nc)/3\\.0/((au|at|br|cl|cn|cr|hr|cz|ec|eg|ee|fr|de|gr|gt|hk|igo|ie|it|lu|nl|nz|no|ph|pl|pt|pr|ro|rs|sg|za|es|ch|tw|th|ug|us|ve|vn)/)?$" ]
      [ sh:pattern "^http://creativecommons\\.org/licenses/(by|by-sa|by-nd|by-nc|by-nc-sa|by-nd-nc)/4\\.0/$" ]
      [ sh:pattern "^http://rightsstatements\\.org/vocab/(NoC-NC|NoC-OKLR|InC|InC-EDU|InC-EU-OW|CNE)/1\\.0/$" ]
      [ sh:pattern "^http://creativecommons\\.org/publicdomain/(zero|mark)/1\\.0/$" ]
    ) .


############################
### Property definitions ###
############################

# These shapes define the properties including their value type and any literal value restrictions.
# Note: by themselves these don't do anything. They need to be used in node shapes for resources.

# The conditions for a string literal or IRI property definition.
:stringLiteralOrIRICondition
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:nodeKind sh:IRI ] ) .

# The conditions for a string literal property definition.
:stringLiteralCondition
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) .

# The condition for an IRI property definition.
:iriCondition
    sh:nodeKind sh:IRI .

# Set the message and conditions for a string literal or decimal property definition.
# TODO These properties should be encouraged to be decimal - but does our pipeline support it?
:stringOrDecimalLiteralCondition
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:decimal ] ) .


# Set the message and conditions for a string literal or positive integer property definition.
# TODO These properties should be encouraged to be integer - but does our pipeline support it?
:stringOrPositiveIntegerLiteralCondition
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:positiveInteger ] ) .


:ccDeprecatedOnProperty
    sh:path     cc:deprecatedOn ;
    sh:datatype xsd:date ;
    sh:message  "This property must be a literal of type 'date'." .

