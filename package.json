{
  "name": "@loda/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "pipeline",
    "validation-tool"
  ],
  "scripts": {
    "pipeline:start": "ROOT_DIR=$(pwd) npm run start -w pipeline --",
    "pipeline:describe": "ROOT_DIR=$(pwd) npm run describe -w pipeline --",
    "pipeline:upload": "ROOT_DIR=$(pwd) npm run upload -w pipeline --",
    "pipeline:test": "npm run test -w pipeline --",
    "validation-tool:start": "npm run dev -w validation-tool",
    "lint": "eslint . && prettier --check pipeline/src validation-tool/src",
    "fix": "eslint --fix . && prettier --write pipeline/src validation-tool/src",
    "clean": "rm -rf pipeline/build/ imports/ output/"
  },
  "dependencies": {
    "@lde/pipeline": "https://github.com/daanjo3/lde/releases/download/fork-26070983/lde-pipeline.tgz",
    "@lde/pipeline-void": "https://github.com/daanjo3/lde/releases/download/fork-26070983/lde-pipeline-void.tgz",
    "@lde/search-pipeline": "https://github.com/daanjo3/lde/releases/download/fork-26070983/lde-search-pipeline.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  },
  "overrides": {
    "@lde/pipeline": "$@lde/pipeline",
    "@lde/pipeline-void": "$@lde/pipeline-void",
    "@lde/search-pipeline": "$@lde/search-pipeline"
  }
}
