{
  "name": "@loda/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "pipeline",
    "validation-tool"
  ],
  "scripts": {
    "pipeline:start": "ROOT_DIR=$(pwd) npm run start -w pipeline",
    "validation-tool:start": "npm run dev -w validation-tool",
    "lint": "eslint . && prettier --check pipeline/src validation-tool/src",
    "fix": "eslint --fix . && prettier --write pipeline/src validation-tool/src",
    "clean": "rm -rf pipeline/build/ imports/ output/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  }
}
