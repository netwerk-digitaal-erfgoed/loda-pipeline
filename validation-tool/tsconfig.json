{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": ["src", "server", "scripts", "types", "vite.config.ts"]
}
