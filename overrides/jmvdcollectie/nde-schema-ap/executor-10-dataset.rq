PREFIX sdo: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  $this sdo:additionalType ?artform .
  ?artform a sdo:DefinedTerm ;
    sdo:name ?artformName .
  ?size sdo:value ?number .
}
WHERE {
  # SCHEMA-AP-NDE has no artform: it says what additionalType says.
  {
    $this sdo:artform ?_artform .
    FILTER(!ISBLANK(?_artform))
    OPTIONAL { ?_artform sdo:name ?_artformName }
    BIND(IF(ISIRI(?_artform), ?_artform, IRI(CONCAT(STR($this), "#term-", ENCODE_FOR_URI(STR(?_artform))))) AS ?artform)
    BIND(COALESCE(?_artformName, IF(ISLITERAL(?_artform), ?_artform, 1/0)) AS ?_name)
    BIND(IF(LANG(?_name) != "", ?_name, STRLANG(STR(?_name), "nl")) AS ?artformName)
  }

  # SCHEMA-AP-NDE has a numeric size value, this dataset sometimes has a decimal comma.
  # The size IRI is the one base/pre-transform/executor-10-values.rq mints.
  UNION {
    $this sdo:size ?_size .
    ?_size sdo:value ?_value .
    FILTER(!ISLITERAL(?_size))
    FILTER(DATATYPE(?_value) = xsd:string && REGEX(STR(?_value), "^[0-9]+,[0-9]+$"))
    OPTIONAL { ?_size sdo:unitText ?_unitText }
    BIND(IF(ISIRI(?_size), ?_size,
      IRI(CONCAT(STR($this), "#size-", ENCODE_FOR_URI(CONCAT(STR(?_value), " ", COALESCE(STR(?_unitText), ""))))))
      AS ?size)
    BIND(STRDT(REPLACE(STR(?_value), ",", "."), xsd:decimal) AS ?number)
  }
}
